{
  "name": "@pv-lens/core",
  "version": "0.0.0",
  "private": true,
  "description": "pv-lens 共享核心库：纯 TypeScript，无 Node/浏览器 API，浏览器与 Node 双端可用",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "sync:sample-texts": "node scripts/sync-sample-texts.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
